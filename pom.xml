<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>me.wildn00b</groupId>
	<artifactId>timegivesyoumoney</artifactId>
	<version>1.3.0-SNAPSHOT</version>
	<name>TimeGivesYouMoney</name>
	<description>Gives players money every minute</description>
	<url>http://dev.bukkit.org/server-mods/TimeGivesYouMoney/</url>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<folia-api.vesion>1.21.8-R0.1-SNAPSHOT</folia-api.vesion>
	</properties>

	<repositories>
		<repository>
			<id>papermc</id>
			<url>https://repo.papermc.io/repository/maven-public/</url>
		</repository>
		<repository>
			<id>codemc-creatorfromhell</id>
			<url>https://repo.codemc.io/repository/creatorfromhell/</url>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>cn.handyplus.lib.adapter</groupId>
			<artifactId>FoliaLib</artifactId>
			<version>1.2.3</version>
			<exclusions>
				<exclusion>
					<groupId>dev.folia</groupId>
					<artifactId>folia-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>net.milkbowl.vault</groupId>
			<artifactId>VaultUnlockedAPI</artifactId>
			<version>2.16</version><!-- Validate this is the most recent version from the CI -->
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>dev.folia</groupId>
			<artifactId>folia-api</artifactId>
			<version>${folia-api.vesion}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.1</version>
				<configuration>
					<createDependencyReducedPom>false</createDependencyReducedPom>
					<artifactSet>
						<includes>
							<include>cn.handyplus.lib.adapter:*:*:*</include>
						</includes>
					</artifactSet>
					<relocations>
						<relocation>
							<pattern>cn.handyplus.lib.adapter</pattern>
							<shadedPattern>me.wildn00b.timegivesyoumoney.libs</shadedPattern>
						</relocation>
					</relocations>
				</configuration>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
